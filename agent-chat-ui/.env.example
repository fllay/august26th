# LangGraph Configuration
# For local UI development against the backend exposed on the host:
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=agent

# Used by the Next.js API passthrough when running inside Docker Compose:
LANGGRAPH_API_URL=http://backend:2024

# Do NOT prefix this with NEXT_PUBLIC_ because it must not be exposed to the browser.
LANGSMITH_API_KEY=

# Production example:
# NEXT_PUBLIC_ASSISTANT_ID=agent
# LANGGRAPH_API_URL=https://my-agent.default.us.langgraph.app
# NEXT_PUBLIC_API_URL=https://my-website.com/api
# LANGSMITH_API_KEY=lsv2_...
