# LLM provider: openrouter or local
LLM_PROVIDER=local

# OpenRouter configuration
# Use this provider when you want hosted models instead of a local OpenAI-compatible server.
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=openai/gpt-4.1
OPENROUTER_MODEL_2=google/gemini-2.5-flash
OPENROUTER_MODEL_3=anthropic/claude-3.5-haiku

# Optional OpenRouter routing metadata
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Google Form Agent NECTEC

# Local OpenAI-compatible LLM server
# For Docker Desktop on Windows, use host.docker.internal to reach a local server.
# Examples:
# - Ollama:   LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
# - LM Studio: LOCAL_LLM_BASE_URL=http://host.docker.internal:1234/v1
# - Remote Ollama server: LOCAL_LLM_BASE_URL=http://server-ip-or-hostname:11434/v1
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=qwen3:14b
LOCAL_LLM_API_KEY=not-needed

# Web UI backend connection
# Browser-facing URL used by the Next.js client.
WEBUI_PUBLIC_API_URL=http://localhost:2024
# Docker-internal URL used by the Next.js API proxy.
WEBUI_LANGGRAPH_API_URL=http://backend:2024
WEBUI_ASSISTANT_ID=agent

# Google Forms MCP server
# Build the bundled server with:
#   cd mcp\google-forms-mcp
#   npm install
#   npm run build
GOOGLE_FORMS_MCP_PATH=./mcp/google-forms-mcp/build/index.js

# Google OAuth credentials used by both the backend and the web UI OAuth flow.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Optional if you want the backend to use a pre-created refresh token instead of the
# shared web UI OAuth login.
#
# Leave this blank if you want to reconnect Google in the web UI and let the backend
# pick up the shared token with the newer Apps Script scopes required for:
# - automatic form -> spreadsheet linking
# - immediate response-sheet post-processing
GOOGLE_REFRESH_TOKEN=

# Shared OAuth token storage path used by the backend and web UI.
# In Docker Compose this is typically mounted under /data inside containers.
GOOGLE_OAUTH_TOKEN_PATH=.data/google-oauth.json

# Optional alternative Google auth inputs for Sheets / Forms access
# Use one of these only if you are not relying on the shared web UI OAuth login.
SERVICE_ACCOUNT_PATH=
TOKEN_PATH=
CREDENTIALS_CONFIG=

# Apps Script runtime for automatic form -> spreadsheet linking and immediate
# response-sheet post-processing.
# Create one shared Apps Script project, switch it to the same GCP project as the
# OAuth client, deploy it as an API executable with Execution API access set to
# ANYONE, then place the ids here.
GOOGLE_APPS_SCRIPT_PROJECT_ID=
GOOGLE_APPS_SCRIPT_DEPLOYMENT_ID=

# Optional Google Sheets MCP server for broader spreadsheet analysis flows.
# The current product workflow is:
# 1. agent creates the Google Form
# 2. agent automatically creates and links the response spreadsheet
# 3. agent immediately tries to post-process the linked response sheet
# 4. user can still send the spreadsheet link back for reformatting or deeper analysis
#
# When enabled, the Sheets MCP server will reuse the shared Google OAuth login automatically
# if TOKEN_PATH is not explicitly set and the shared token file exists.
ENABLE_GOOGLE_SHEETS_MCP=false

# Optional subset of enabled Sheets MCP tools. Leave blank for the repo default.
GOOGLE_SHEETS_ENABLED_TOOLS=

# Optional drive folder hint supported by some Google Sheets MCP setups.
DRIVE_FOLDER_ID=
