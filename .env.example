# LLM provider: openrouter or local
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=openai/gpt-4.1
OPENROUTER_MODEL_2=google/gemini-2.5-flash
OPENROUTER_MODEL_3=anthropic/claude-3.5-haiku

# Optional OpenRouter routing metadata
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Google Form Agent NECTEC

# Local OpenAI-compatible LLM server
# For Docker Desktop, use host.docker.internal to reach a local server on Windows.
# Examples:
# - Ollama: LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
# - LM Studio: LOCAL_LLM_BASE_URL=http://host.docker.internal:1234/v1
# - Remote Ollama server: LOCAL_LLM_BASE_URL=http://server-ip-or-hostname:11434/v1
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_API_KEY=not-needed

# Web UI backend connection
# Browser-facing URL used by the Next.js client.
WEBUI_PUBLIC_API_URL=http://localhost:2024
# Docker-internal URL used by the Next.js API proxy.
WEBUI_LANGGRAPH_API_URL=http://backend:2024
WEBUI_ASSISTANT_ID=agent

# Google Forms MCP server
# Build the bundled server with: cd mcp\google-forms-mcp && npm install && npm run build
GOOGLE_FORMS_MCP_PATH=C:\Program Files (x86)\Git\august26th\mcp\google-forms-mcp\build\index.js

# Google OAuth credentials used by the MCP server.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional if you will connect Google through the web UI OAuth flow.
GOOGLE_REFRESH_TOKEN=

# Shared OAuth storage path. In Docker Compose this is mounted at /data.
GOOGLE_OAUTH_TOKEN_PATH=.data/google-oauth.json


# Optional Google Sheets MCP server for response analysis skills.
# When enabled, it will reuse the app's shared Google OAuth login automatically.
ENABLE_GOOGLE_SHEETS_MCP=false
# Default subset includes core read/write analysis tools plus chart creation;
# override only if needed.
GOOGLE_SHEETS_ENABLED_TOOLS=
# Optional service account auth instead of shared web OAuth:
SERVICE_ACCOUNT_PATH=
DRIVE_FOLDER_ID=
# Optional direct credential injection supported by upstream MCP:
CREDENTIALS_CONFIG=
